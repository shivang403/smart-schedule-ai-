{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty member eligible for teaching courses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 80 },
        "maxHoursPerDay": { "type": "number" },
        "unavailableDays": { "type": "array" },
        "unavailableSlots": { "type": "array" },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "department"]
    },
    "Room": {
      "title": "Room",
      "description": "College classroom or laboratory facility",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "capacity": { "type": "number" },
        "type": { "type": "string", "maxLength": 50 },
        "unavailableAfterTime": { "type": "string", "maxLength": 10 },
        "unavailableSlots": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "capacity", "type"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic course required in the timetable",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 100 },
        "assignedTeacherId": { "type": "string", "maxLength": 64 },
        "weeklySessionsRequired": { "type": "number" },
        "preferredRoomType": { "type": "string", "maxLength": 50 },
        "classSections": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "name", "assignedTeacherId", "weeklySessionsRequired", "classSections"]
    },
    "Constraint": {
      "title": "Constraint",
      "description": "Administrative scheduling rule or constraint",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 250 },
        "targetId": { "type": "string", "maxLength": 64 },
        "enabled": { "type": "boolean" },
        "priority": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "type", "description", "enabled"]
    },
    "Timetable": {
      "title": "Timetable",
      "description": "Generated college weekly timetable",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "classSections": { "type": "array" },
        "slots": { "type": "array" },
        "unscheduledItems": { "type": "array" },
        "conflictCount": { "type": "number" },
        "conflicts": { "type": "array" },
        "healthScore": { "type": "number" },
        "teacherWorkloadScore": { "type": "number" },
        "roomUtilizationRate": { "type": "number" },
        "constraintCheckResults": { "type": "array" },
        "geminiInsights": { "type": "object" }
      },
      "required": ["id", "name", "createdAt", "slots", "healthScore"]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Faculty profile and availability definitions"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Campus rooms, capacities, and restriction rules"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Curriculum subjects with assigned teachers and session loads"
    },
    "/constraints/{constraintId}": {
      "schema": "Constraint",
      "description": "Institutional scheduling constraints and operational limits"
    },
    "/timetables/{timetableId}": {
      "schema": "Timetable",
      "description": "Persisted generated timetable schedules with conflict reports"
    }
  }
}
