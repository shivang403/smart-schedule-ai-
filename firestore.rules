rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace this placeholder with the Firebase Authentication UID of the
    // administrator account before publishing these rules in Firebase.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_FIREBASE_UID';
    }

    match /teachers/{teacherId} {
      allow read, write: if isAdmin();
    }
    match /rooms/{roomId} {
      allow read, write: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read, write: if isAdmin();
    }
    match /constraints/{constraintId} {
      allow read, write: if isAdmin();
    }
    match /timetables/{timetableId} {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
